{
  "manifest_version": 3,
  "name": "GitHub PR Summary Generator",
  "version": "1.0",
  "description": "Generate summaries for GitHub pull requests.",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.svg",
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "options_page": "settings.html",
  "web_accessible_resources": [
    {
      "resources": [
        "content/branchInfo.js",
        "content/dom.js",
        "content/utils.js",
        "content/api.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "type": "module",
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}